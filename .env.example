# Copy to .env (never commit .env) and fill in values.
# Read by both `docker compose` (for Hindsight) and the FastAPI backend.
# The defaults below run the app with NO API keys: SQLite only, memory disabled,
# no AI provider. Every value is optional unless noted.

# --- Business records ---------------------------------------------------------
# Default: backend/data/deal_rescue.db (created automatically, gitignored).
# DATABASE_URL=sqlite:///D:/path/to/deal_rescue.db

# --- AI provider boundary -----------------------------------------------------
# none (default: AI features report "unavailable"; nothing is generated)
# ollama (M5: local Ollama, deal briefings only). anthropic: planned, not implemented.
AI_PROVIDER=none
AI_TIMEOUT_SECONDS=60
# Retries apply to timeouts/transient errors. Use 0 with a local model: a timed-out local
# generation would only be repeated at the same cost.
AI_MAX_RETRIES=2
# Used by the planned Anthropic adapter AND passed to Hindsight as its internal LLM key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Local Ollama (AI_PROVIDER=ollama). Keep it on 127.0.0.1. The model must be pulled first:
#   ollama pull qwen3:4b   (about 2.5 GB; smoke-tested on a 4 GB GPU)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=4096
# qwen3 "thinking" adds latency; keep false for briefings.
OLLAMA_THINK=false

# --- Deterministic deal intelligence (M4) -------------------------------------
# Per-stage inactivity thresholds (days) as JSON; stages not listed use the default.
INTEL_STALL_DAYS_DEFAULT=14
INTEL_STALL_DAYS_BY_STAGE={"discovery": 21, "qualification": 14, "proposal": 10, "negotiation": 7, "closing": 5}
# Interaction channels that count as customer activity (JSON list). note/other are internal.
INTEL_MEANINGFUL_CHANNELS=["call", "meeting", "email", "message"]
# Commitments due within this many days are "due soon".
INTEL_DUE_SOON_DAYS=7
# IANA timezone that defines "today" for date-only deadlines.
INTEL_TIMEZONE=UTC

# --- Memory boundary ----------------------------------------------------------
# disabled (default): never contacts Hindsight; memory endpoints return 503.
# hindsight: one bank per customer + shared outcomes bank (needs the Hindsight server).
MEMORY_BACKEND=disabled
# Quick retries inside one sync job (connectivity / 429 / 5xx gateway errors only).
MEMORY_MAX_ATTEMPTS=3
# Durable sync worker (M3): state lives in SQLite; restarts resume pending work.
MEMORY_WORKER_ENABLED=true
MEMORY_WORKER_POLL_SECONDS=5
# Job-level attempts before a row needs an explicit retry; exponential backoff between them.
MEMORY_SYNC_MAX_ATTEMPTS=5
MEMORY_RETRY_BASE_SECONDS=30
MEMORY_RETRY_MAX_SECONDS=3600
# Must exceed HINDSIGHT_TIMEOUT_SECONDS * MEMORY_MAX_ATTEMPTS (validated at startup).
MEMORY_LEASE_SECONDS=600
HINDSIGHT_CUSTOMER_BANK_PREFIX=deal-rescue-cust-
HINDSIGHT_OUTCOMES_BANK_ID=deal-rescue-outcomes
# Leave empty. "chunks" stores text without the LLM and exists only for credential-free tests.
HINDSIGHT_EXTRACTION_MODE=

# --- Hindsight server (docker-compose.yml) ----------------------------------
# anthropic: needs ANTHROPIC_API_KEY (Hindsight 0.10.1 refuses to start without it).
# none: official no-LLM mode, no key needed. The server stores raw chunks only (no fact
#       extraction, no observations) and rejects reflect. Use with HINDSIGHT_EXTRACTION_MODE=chunks.
HINDSIGHT_LLM_PROVIDER=anthropic
# Model Hindsight uses internally. claude-haiku-4-5 is Hindsight 0.10.1's own
# default for the anthropic provider. Do not use claude-opus-5-5 or
# claude-fable-5-1 here: Hindsight forces tool_choice, which those models reject.
HINDSIGHT_LLM_MODEL=claude-haiku-4-5
HINDSIGHT_LOG_LEVEL=info

# --- Hindsight client (backend) ---------------------------------------------
# self_hosted (default): the Docker server below. cloud: Hindsight Cloud (managed LLM, billed credits).
HINDSIGHT_DEPLOYMENT=self_hosted
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_CLOUD_BASE_URL=https://api.hindsight.vectorize.io
# Hindsight Cloud API key (hsk_...). Sent ONLY when HINDSIGHT_DEPLOYMENT=cloud, ONLY to the Cloud URL.
# Create it in the Hindsight Cloud console; never commit it.
HINDSIGHT_API_KEY=
# Only for a self-hosted server with API-key auth enabled (not enabled by docker-compose.yml).
HINDSIGHT_SELF_HOSTED_API_KEY=
HINDSIGHT_TIMEOUT_SECONDS=120
# Bank used only by the M1 spike script (scripts/hindsight_spike.py).
HINDSIGHT_BANK_ID=deal-rescue-demo
